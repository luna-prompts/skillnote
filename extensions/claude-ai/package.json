{
  "name": "skillnote-extension",
  "version": "0.1.0",
  "private": true,
  "description": "SkillNote browser extension for claude.ai sync",
  "scripts": {
    "build": "vite build",
    "build:chrome": "vite build",
    "build:firefox": "SKILLNOTE_TARGET=firefox vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "package": "vite build && cd dist && zip -r ../skillnote-extension-chrome.zip .",
    "package:firefox": "SKILLNOTE_TARGET=firefox vite build && cd dist && zip -r ../skillnote-extension-firefox.zip ."
  },
  "devDependencies": {
    "@types/chrome": "^0.0.270",
    "@vitest/coverage-v8": "^3.2.6",
    "jsdom": "^25.0.1",
    "typescript": "^5.4.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.6"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
